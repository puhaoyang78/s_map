# Copy this file to /etc/detection-agent/agent.env (or another secure path)
# and replace placeholder values before starting the agent service.
# For direct local CLI runs, copy the same values into detection_server_agent.env.local.
# After updating the file, validate it with:
#   python scripts/preflight_check.py --agent-env-file /etc/detection-agent/agent.env

AGENT_TOKEN=replace-with-a-long-random-agent-token

PROBE_SCRIPT_PATH=replace-with-your-probe-script-path
ENCRYPTED_ARTIFACT_DIR=replace-with-your-encrypted-artifact-dir
ENCRYPTED_ARTIFACT_PATTERN=*_enc.7z
PROBE_PYTHON_BIN=python3
# Seconds before a hung probe run is killed. 0 disables the timeout entirely:
# a stuck probe script then leaks its worker thread and child process forever,
# so keep a generous finite cap in production.
PROBE_TIMEOUT_SECONDS=7200
# Max probe jobs allowed to run at the same time; extra requests get HTTP 409.
AGENT_MAX_CONCURRENT_JOBS=4

AGENT_TLS_CERT_FILE=/etc/detection-agent/pki/certs/agent-fullchain.pem
AGENT_TLS_KEY_FILE=/etc/detection-agent/pki/private/agent.key

AGENT_CALLBACK_TIMEOUT_SECONDS=8
AGENT_CALLBACK_RETRIES=3
AGENT_CALLBACK_BACKOFF_SECONDS=1.2
AGENT_CALLBACK_REQUIRE_TOKEN=true
AGENT_CALLBACK_ALLOW_INSECURE_HTTP=false
AGENT_CALLBACK_ALLOW_PRIVATE_HOSTS=false
# Comma-separated allowlist of backend hosts that may receive job callbacks
# (IP or hostname; must match the host of the callback URL the backend sends).
AGENT_CALLBACK_ALLOWED_HOSTS=replace-with-your-backend-ip
AGENT_CALLBACK_ALLOWED_PORTS=443,5443

AGENT_LOG_LEVEL=INFO
AGENT_LOG_FILE=/var/log/detection-agent/agent.log
AGENT_LOG_MAX_BYTES=10485760
AGENT_LOG_BACKUP_COUNT=5
